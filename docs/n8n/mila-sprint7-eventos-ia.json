{
  "name": "MILA Sprint 7 - Eventos e IA",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mila-events",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-events",
      "name": "Webhook MILA",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "wh-events-hook"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true, \"flow\": $('Webhook MILA').item.json.body.flow, \"received\": true } }}",
        "options": {}
      },
      "id": "resp-events",
      "name": "Responder 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $('Webhook MILA').item.json.body.flow }}",
              "rightValue": "ticket.created",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $('Webhook MILA').item.json.body.aiViaN8n }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-ai",
      "name": "¿IA delegada a n8n?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MILA_URL }}/api/automation/ai-analyze",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-mila-secret",
              "value": "={{ $env.MILA_CALLBACK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ticketId: $('Webhook MILA').item.json.body.ticketId }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "http-ai",
      "name": "MILA: analizar con IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {},
      "id": "noop",
      "name": "Sin acción adicional",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        960,
        400
      ]
    }
  ],
  "connections": {
    "Webhook MILA": {
      "main": [
        [
          {
            "node": "Responder 200",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Responder 200": {
      "main": [
        [
          {
            "node": "¿IA delegada a n8n?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿IA delegada a n8n?": {
      "main": [
        [
          {
            "node": "MILA: analizar con IA",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Sin acción adicional",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}