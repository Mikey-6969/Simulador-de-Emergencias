{
  "name": "MILA Sprint 7 - Notificaciones externas",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mila-notify",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-notify",
      "name": "Webhook notificaciones",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "wh-notify-hook"
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.MILA_MAIL_FROM || 'mila@example.com' }}",
        "toEmail": "={{ $json.body.to }}",
        "subject": "={{ $json.body.subject }}",
        "emailFormat": "text",
        "text": "={{ 'Hola ' + $json.body.toName + ',\\n\\n' + $json.body.body + ($json.body.ticketNumber ? '\\n\\nCaso: ' + $json.body.ticketNumber : '') + '\\n\\n— MILA Mesa de Ayuda' }}",
        "options": {}
      },
      "id": "mail",
      "name": "Enviar correo",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        480,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "CONFIGURAR",
          "name": "SMTP MILA"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": !$json.error, \"notificationId\": $('Webhook notificaciones').item.json.body.notificationId } }}",
        "options": {}
      },
      "id": "resp-notify",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        300
      ]
    }
  ],
  "connections": {
    "Webhook notificaciones": {
      "main": [
        [
          {
            "node": "Enviar correo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar correo": {
      "main": [
        [
          {
            "node": "Responder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}